{
    "name": "hampel/binarylane-api-laravel",
    "description": "Laravel service provider, manager, facade and queued action polling for the BinaryLane API client, with Http::fake() support",
    "authors": [
        {
            "name": "Simon Hampel",
            "email": "simon@hampelgroup.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/hampel/binarylane-api-laravel/issues",
        "source": "https://github.com/hampel/binarylane-api-laravel"
    },
    "keywords": [
        "binarylane",
        "vps",
        "cloud",
        "servers",
        "api",
        "laravel"
    ],
    "homepage": "https://github.com/hampel/binarylane-api-laravel",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "guzzlehttp/guzzle": "^7.8|^8.0",
        "guzzlehttp/psr7": "^2.0|^3.0",
        "hampel/binarylane-api": "^0.1",
        "illuminate/bus": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1|^2.0",
        "psr/log": "^1.1|^2.0|^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.4.2",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.1.22",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Hampel\\BinaryLane\\Api\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hampel\\BinaryLane\\Api\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hampel\\BinaryLane\\Api\\Laravel\\BinaryLaneServiceProvider"
            ],
            "aliases": {
                "BinaryLane": "Hampel\\BinaryLane\\Api\\Laravel\\Facades\\BinaryLane"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint",
        "lint": "pint --test",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
